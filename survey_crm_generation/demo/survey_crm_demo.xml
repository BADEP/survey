<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="tag_survey_leads" model="crm.tag">
        <field name="name">Survey Leads</field>
    </record>
    <record id="tag_oca_partnership" model="crm.tag">
        <field name="name">OCA Partnership</field>
    </record>
    <!-- Sales Team -->
    <record id="oca_partnership_leads" model="crm.team">
        <field name="name">OCA Partnership</field>
    </record>
    <!-- Survey -->
    <record id="become_partner" model="survey.survey">
        <field name="title">Become OCA Partner</field>
        <field name="description">Be part of the Odoo Community!</field>
        <field name="access_token">08b4db21-66cc-4c69-a712-cc364c54902c</field>
        <field name="access_mode">public</field>
        <field name="generate_leads" eval="True" />
        <field name="crm_team_id" ref="oca_partnership_leads" />
        <field
            name="crm_tag_ids"
            eval="[(6,0,[ref('survey_crm_generation.tag_oca_partnership'), ref('survey_crm_generation.tag_survey_leads')])]"
        />
        <field name="users_can_go_back" eval="True" />
    </record>
    <record id="survey_oca_q0" model="survey.question">
        <field name="survey_id" ref="become_partner" />
        <field name="sequence" eval="0" />
        <field name="title">E-mail address</field>
        <field name="question_type">text_box</field>
        <field name="show_in_lead_description" eval="True" />
        <field name="constr_mandatory" eval="True" />
    </record>
    <record id="survey_oca_q1" model="survey.question">
        <field name="survey_id" ref="become_partner" />
        <field name="sequence" eval="1" />
        <field name="title">Your company name?</field>
        <field name="question_type">text_box</field>
        <field name="show_in_lead_description" eval="True" />
        <field name="constr_mandatory" eval="True" />
    </record>
    <record id="survey_oca_q3" model="survey.question">
        <field name="survey_id" ref="become_partner" />
        <field name="sequence" eval="2" />
        <field name="title">And your name?</field>
        <field name="question_type">text_box</field>
        <field name="show_in_lead_description" eval="True" />
        <field name="constr_mandatory" eval="True" />
    </record>
    <record id="survey_oca_q4" model="survey.question">
        <field name="survey_id" ref="become_partner" />
        <field name="sequence" eval="6" />
        <field name="title">Referenced by</field>
        <field name="question_type">simple_choice</field>
        <field name="comments_allowed" eval="True" />
        <field name="comment_count_as_answer" eval="True" />
        <field name="comments_message">Other:</field>
        <field name="crm_lead_field" ref="crm.field_crm_lead__referred" />
        <field name="constr_mandatory" eval="True" />
    </record>
    <record id="survey_oca_q4_sug1" model="survey.question.answer">
        <field name="question_id" ref="survey_oca_q4" />
        <field name="sequence" eval="1" />
        <field name="value">TV</field>
    </record>
    <record id="survey_oca_q4_sug2" model="survey.question.answer">
        <field name="question_id" ref="survey_oca_q4" />
        <field name="sequence" eval="2" />
        <field name="value">Internet</field>
    </record>
</odoo>
