<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="survey_representative_demo" model="survey.survey">
        <field name="title">Meal preferences</field>
        <field name="access_mode">public</field>
        <field name="users_can_go_back" eval="True" />
    </record>
    <record id="survey_representative_q0" model="survey.question">
        <field name="survey_id" ref="survey_representative_demo" />
        <field name="sequence" eval="0" />
        <field name="title">Name</field>
        <field name="question_type">char_box</field>
        <field name="constr_mandatory" eval="True" />
    </record>
    <record id="survey_representative_q1" model="survey.question">
        <field name="survey_id" ref="survey_representative_demo" />
        <field name="sequence" eval="1" />
        <field name="title">Email</field>
        <field name="question_type">char_box</field>
    </record>
    <record id="survey_representative_q5" model="survey.question">
        <field name="survey_id" ref="survey_representative_demo" />
        <field name="sequence" eval="4" />
        <field name="title">What would you like for dinner?</field>
        <field name="question_type">simple_choice</field>
    </record>
    <record id="survey_representative_q5_sug1" model="survey.question.answer">
        <field name="question_id" ref="survey_representative_q5" />
        <field name="sequence" eval="1" />
        <field name="value">Meat</field>
    </record>
    <record id="survey_representative_q5_sug2" model="survey.question.answer">
        <field name="question_id" ref="survey_representative_q5" />
        <field name="sequence" eval="2" />
        <field name="value">Fish</field>
    </record>
    <record id="survey_representative_q5_sug3" model="survey.question.answer">
        <field name="question_id" ref="survey_representative_q5" />
        <field name="sequence" eval="3" />
        <field name="value">Vegan</field>
    </record>
</odoo>
